# ─────────────────────────────────────────────────────────────────────────────
# Plantilla de configuración. Copiar a `.env` y completar.
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# Ruta del archivo SQLite (relativa a la raíz del proyecto o absoluta).
DATABASE_PATH=./data/bufete.db

# Secreto de sesiones de Better Auth. Generar con:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=

# URL base con la que se sirve la app. En la PC de oficina, la IP LAN fija:
#   http://192.168.1.50:3000
BETTER_AUTH_URL=http://localhost:3000

# Puerto del servidor Node (Next + Socket.IO + Hocuspocus).
PORT=3000

# ── IA (Secciones 3 y 6) ─────────────────────────────────────────────────────
# Clave de Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Búsqueda web dentro del chat IA. Dejar en false (aún no hay proveedor configurado).
WEB_SEARCH_ENABLED=false

# ── Microsoft Graph (Sección 6 — resumen de correos) ─────────────────────────
# Opcional. Si el bufete no registra app en Entra ID, la Sección 6 queda
# "No configurada" y el resto del sistema funciona igual.
MSGRAPH_CLIENT_ID=
MSGRAPH_TENANT_ID=common

# Clave para cifrar secretos en la BD (AES-256-GCM). 32 bytes hex:
#   openssl rand -hex 32
ENCRYPTION_KEY=

# ── Casillero outbite.app (Worker despacho-casillero). No usar Gmail ni Calórico. ─
CASILLERO_WORKER_URL=
CASILLERO_WORKER_SECRET=

